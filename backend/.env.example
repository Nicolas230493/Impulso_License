# Entorno: development | test | production. El seed de datos de demostración solo corre en development o test.
NODE_ENV=development
# Usuario de aplicación: solo lee y escribe datos. Ver docker/postgres/01-usuario-app.sh y ../.env.example
DATABASE_URL="postgresql://impulso_license_app:CAMBIAR@localhost:5433/impulso_license?schema=public"
# Dueño del esquema: solo lo usa `prisma migrate` (la aplicación nunca se conecta con este usuario).
DATABASE_URL_MIGRACIONES="postgresql://impulso_license_owner:CAMBIAR@localhost:5433/impulso_license?schema=public"
PORT=3000
# Orígenes exactos del frontend, separados por coma. No se admite "*". En producción, solo https.
CORS_ORIGINS=http://localhost:5173
# Al menos 32 bytes aleatorios (el servidor no arranca con un valor de ejemplo). Generar (Linux o Windows):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TTL_DIAS=7
STORAGE_DIR=./storage
MAX_UPLOAD_MB=10
# Cookie de sesión con atributo Secure. En producción es obligatoria (con false el servidor no arranca).
COOKIE_SECURE=true
# IP o subredes del proxy inverso real, separadas por coma (p. ej. 10.0.0.5 o 172.18.0.0/16).
# Vacío = no se confía en X-Forwarded-For.
TRUSTED_PROXIES=
# Obligatoria en producción: throttling compartido entre réplicas y tareas programadas (BullMQ).
# REDIS_URL=redis://:CONTRASEÑA@localhost:6380
# Solo desarrollo/pruebas: contraseña de los usuarios de demostración del seed (si falta, se generan al azar y no se muestran).
# SEED_ADMIN_PASSWORD=
# Clave AES-256 para cifrar los archivos subidos y los secretos del segundo factor (64 caracteres hex).
# Obligatoria en producción. Guárdela aparte: sin ella no se pueden leer los archivos. Generar:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CLAVE_CIFRADO=
# Antivirus ClamAV (obligatorio en producción). En desarrollo: docker compose --profile antivirus up -d
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310
# Segundo factor obligatorio para ADMIN y SUPERVISOR (siempre en producción; opcional en desarrollo).
# EXIGIR_2FA=true
