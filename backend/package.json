{
  "name": "impulso-license-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "lint:types": "tsc --noEmit",
    "test": "jest",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "bootstrap:admin": "ts-node prisma/bootstrap-admin.ts",
    "test:e2e": "node test/smoke.e2e.mjs && node test/seguridad.e2e.mjs && node test/ley647.e2e.mjs",
    "audit:ci": "npm audit --audit-level=high",
    "migrar:solicitudes": "ts-node prisma/migrar-solicitudes.ts",
    "importar:disposiciones": "ts-node prisma/importar-disposiciones.ts",
    "cargar:nomenclador": "ts-node prisma/cargar-nomenclador.ts",
    "cifrar:archivos": "ts-node prisma/cifrar-archivos.ts"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@nest-lab/throttler-storage-redis": "1.2.0",
    "@nestjs/common": "11.2.11",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.11",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.2.11",
    "@nestjs/schedule": "6.1.3",
    "@nestjs/throttler": "6.4.0",
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.2",
    "bullmq": "6.7.8",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "cookie-parser": "1.4.7",
    "exceljs": "4.4.0",
    "helmet": "8.1.0",
    "ioredis": "6.1.0",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pdfkit": "0.17.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.11",
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.3",
    "@types/jest": "29.5.14",
    "@types/multer": "2.0.0",
    "@types/node": "22.18.0",
    "@types/passport-jwt": "4.0.1",
    "@types/pdfkit": "0.17.2",
    "jest": "29.7.0",
    "prisma": "6.19.3",
    "ts-jest": "29.4.1",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    },
    "deepmerge-ts": "8.0.2",
    "effect": "3.22.5",
    "@nestjs/cli": {
      "glob": "14.0.6"
    }
  }
}
